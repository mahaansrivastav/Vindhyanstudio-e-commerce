# ─── Vindhyan Studio backend: PRODUCTION environment variables ───
# Paste into your backend host's environment variables (Render: Environment → Add from .env;
# Railway: Variables → Raw editor). The same file works on any host.
# Copy to backend/.env.production.local (git-ignored) for scripts/publish-catalogue.sh.
# Replace every <...>. Never commit real values.

SPRING_PROFILES_ACTIVE=prod

# Supabase → Project → Connect → "Session pooler" (JDBC). Keep ?sslmode=require
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# Login tokens. Generate with:  openssl rand -base64 48
JWT_SECRET=<long-random-secret>

# Your URLs
APP_PUBLIC_BASE_URL=https://api.<your-domain>
APP_FRONTEND_URL=https://<your-domain>
APP_CORS_ORIGINS=https://<your-domain>,https://www.<your-domain>

# Who can open /admin (comma-separated emails or 10-digit mobiles)
ADMIN_IDENTITIES=<owner-email>,<your-email>

# Business details (invoices, contact & payment pages)
SELLER_NAME=Vindhyan Studio
# Registered business that owns the brand (invoices + footer)
SELLER_LEGAL_NAME=MORVIN INTEGRATED SOLUTIONS
SELLER_ADDRESS=<full registered address with pincode>
SELLER_STATE=<state, e.g. Uttar Pradesh>
SELLER_GSTIN=
SELLER_EMAIL=<support email>
SELLER_PHONE=+91 94559 38254
SELLER_WHATSAPP=919455938254

# Pricing rules
SHIPPING_FLAT_FEE=60
FREE_SHIPPING_ABOVE=999
COD_ENABLED=true
COD_MAX_ORDER_VALUE=3000

# Files (product photos, customer uploads, invoices) → Supabase Storage
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role / secret key>
SUPABASE_PUBLIC_BUCKET=catalogue
SUPABASE_PRIVATE_BUCKET=private

# Email (login codes + order emails) → Brevo SMTP. REQUIRED: customers log in by email code.
NOTIFY_EMAIL=smtp
NOTIFY_FROM_EMAIL=Vindhyan Studio <orders@<your-domain>>
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<brevo smtp login>
SPRING_MAIL_PASSWORD=<brevo smtp key>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# SMS: not set up yet (mobile login stays hidden)
NOTIFY_SMS=console

# ─── Payments ───  disabled (COD only) | razorpay | cashfree
PAYMENT_PROVIDER=disabled
PAYMENT_REFUND_ON_CANCEL=true
# Razorpay (Dashboard → Account & Settings → API keys; test keys start rzp_test_, live rzp_live_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Cashfree (Dashboard → Developers → API keys). CASHFREE_ENV=sandbox for test keys, production for live.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ─── Shipping ───  manual (owner books courier) | shiprocket
SHIPPING_PROVIDER=manual
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_TOKEN=
# Optional: a fixed courier id from Shiprocket; blank = Shiprocket's recommended courier
SHIPROCKET_COURIER_ID=
# false = book the courier when the owner clicks "Packed" (right for made-to-order); true = right after payment
SHIPROCKET_AUTO_BOOK=false
SHIPROCKET_CANCEL_ON_ORDER_CANCEL=true

# The live server has no Excel folder; publish with scripts/publish-catalogue.sh
CATALOGUE_SYNC_ON_STARTUP=false

JAVA_OPTS=-XX:MaxRAMPercentage=75
